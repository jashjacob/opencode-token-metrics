{
  "name": "opencode-token-metrics",
  "version": "0.2.0",
  "description": "Live tokens-per-second meter for the OpenCode TUI prompt.",
  "type": "module",
  "license": "MIT",
  "author": "Jash Jacob <jash1993@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jashjacob/opencode-token-metrics.git"
  },
  "homepage": "https://github.com/jashjacob/opencode-token-metrics#readme",
  "bugs": {
    "url": "https://github.com/jashjacob/opencode-token-metrics/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "tps",
    "tokens-per-second",
    "throughput",
    "benchmark"
  ],
  "oc-plugin": [
    "tui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./tui": "./src/index.tsx"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.19",
    "opencode": ">=1.4.3"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node --import tsx scripts/smoke.mjs",
    "ci": "sh scripts/ci.sh"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.20",
    "@opencode-ai/sdk": "1.18.20",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0"
  }
}
